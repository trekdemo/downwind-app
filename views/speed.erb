<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Speed</title>
    <style>
        .bar {
            fill: steelblue;
        }
        .bar:hover {
            fill: orange;
        }
        .axis-label {
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div>
        <p><%= total_distance.round(2) %> km in total</p>
        <p><%= on_foil_distance.round(2) %> km on foil</p>
        <p><%= (on_foil_distance / total_distance * 100).round(2) %>% on foil</p>
    </div>
    <svg width="100%" height="100%"></svg>
    <script src="https://cdn.jsdelivr.net/npm/d3@7"></script>
    <script type="module">
        window.averages = (<%= JSON.dump(averages) %>).map(d => {
            d.time = new Date(d.time);
            return d;
        })
        window.data = (<%= JSON.dump(speeds) %>).map(d => {
            d.time = new Date(d.time);
            return d;
        })

        // Set dimensions and margins for the graph
        const margin = { top: 20, right: 20, bottom: 50, left: 50 };
        const width = window.innerWidth - margin.left - margin.right;
        const height = 300 - margin.top - margin.bottom;

        // Create SVG container
        const svg = d3.select("svg")
            .attr("width", width + margin.left + margin.right)
            .attr("height", height + margin.top + margin.bottom)
          .append("g")
            .attr("transform", `translate(${margin.left},${margin.top})`);

        // Set up scales
        const xTime = d3.scaleTime()
        // parse time from string to date
            .domain(d3.extent(data.map((d, i) => d.time)))
            .range([0, width]);
        const xDistance = d3.scaleLinear()
            .domain(d3.extent(data.map((d, i) => d.cum_distance_km)))
            .range([0, width]);
        const x = xDistance;

        const y = d3.scaleLinear()
            .domain(d3.extent(data, d => d.speed).reverse())
            .range([0, height])
            .nice(); // round to nearest nice number
        const y2 = d3.scaleLinear()
            .domain(d3.extent(data, d => d.hr).reverse())
            .range([0, height/2])
            .nice(); // round to nearest nice number

        // Declare the line generator.
        const speedBelow = d3.line()
            .x(d => x(d.cum_distance_km))
            .y(d => y(d.speed))
        const speedAbove = d3.line()
            .x(d => x(d.cum_distance_km))
            .y(d => y(d.speed))
            .defined(d => d.speed >= 12);
        const hr = d3.line()
            .x(d => x(d.cum_distance_km))
            .y(d => y2(d.hr));

        svg.append("path")
        .attr("fill", "none")
        .attr("stroke", "gray")
        .attr("stroke-width", 0.5)
        .attr("d", speedBelow(data));

        svg.append("path")
        .attr("fill", "none")
        .attr("stroke", "steelblue")
        .attr("stroke-width", 2)
        .attr("d", speedAbove(averages));

        // Add the x-axis
        svg.append("g")
            .attr("class", "x-axis")
            .attr("transform", `translate(0,${height})`)
            .call(d3.axisBottom(x))
          .append("text")
            .attr("class", "axis-label")
            .attr("x", width / 2)
            .attr("y", margin.bottom - 10)
            .attr("fill", "black")
            .text("Time");

        // Add the y-axis
        svg.append("g")
            .attr("class", "y-axis")
            .call(d3.axisLeft(y))
          .append("text")
            .attr("class", "axis-label")
            .attr("transform", "rotate(-90)")
            .attr("x", -height / 2)
            .attr("y", -margin.left + 10)
            .attr("fill", "black")
            .text("Speed (km/h)");

        // Plot the HR
        // svg.append("path")
        // .attr("fill", "none")
        // .attr("stroke", "red")
        // .attr("stroke-width", 0.5)
        // .attr("d", hr(data));
        // svg.append("g")
        //     .attr("class", "y-axis")
        //     .call(d3.axisRight(y2))
        //   .append("text")
        //     .attr("class", "axis-label")
        //     .attr("transform", "rotate(-90)")
        //     .attr("x", -height / 2)
        //     .attr("y", -margin.right + 10)
        //     .attr("fill", "black")
        //     .text("HR");
    </script>
</body>
</html>
