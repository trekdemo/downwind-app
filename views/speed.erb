<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Speed</title>
    <style>
        .bar {
            fill: steelblue;
        }

        .bar:hover {
            fill: orange;
        }

        .axis-label {
            font-size: 14px;
        }
    </style>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <table>
        <% activities.each do |a| %>
            <tr>
                <td>
                    <%= a.file %>
                </td>
                <td>
                    <%= a.total_distance.round(2) %>km
                </td>
                <td>
                    <%= a.on_foil_distance.round(2) %>km
                </td>
                <td>
                    <%= (a.on_foil_distance / a.total_distance * 100).round(2) %>%
                </td>
            </tr>
            <% end %>
    </table>

    <% activities.each do |a| %>
        <div class="container p-4 ">
            <div class="border flex columns-2">
                <div class="bg-gray-100 w-1/4 p-2">
                    <h2 class="text-xl mb-2">
                        <%= a.file %>
                    </h2>
                    <dl class="">
                        <dt class="font-bold">Total distance</dt>
                        <dd>
                            <%= a.total_distance.round(2) %>km
                        </dd>
                        <dt class="font-bold">On foil</dt>
                        <dd>
                            <%= a.on_foil_distance.round(2) %>km
                                (<%= (a.on_foil_distance / a.total_distance * 100).round(2) %>%)
                        </dd>
                    </dl>
                </div>
                <svg class="w-3/4"></svg>
            </div>
        </div>
        <% end %>

