<%= form_for :session, url: session_path, html: { class: "space-y-4" } do |form| %>
  <div>
    <%= form.label :email, class: "label" %>
    <%= form.email_field :email, class: "input" %>
  </div>

  <div>
    <%= form.label :password, class: "label" %>
    <%= form.password_field :password, class: "input" %>
  </div>

  <%= form.submit class: "btn-primary w-full" %>

  <div class="flex items-center justify-between text-sm">
    <% if Clearance.configuration.allow_sign_up? %>
      <%= link_to t(".sign_up"), sign_up_path, class: "link" %>
    <% end %>

    <%#= link_to t(".forgot_password"), new_password_path, class: "link" %>
  </div>
<% end %>
