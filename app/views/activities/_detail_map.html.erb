<%# locals: (activity:, sections: []) %>
<div class="card lg:col-span-2">
  <div class="card-header">
    <h2 class="card-title flex items-center gap-1.5">
      <%= icon :"map-pin", class: "size-4 text-accent" %>
      Route
    </h2>
  </div>

  <div
    id="<%= dom_id activity, :map %>"
    class="card-body"
    data-controller="map"
    data-map-gpx-url-value="<%= rails_blob_path(activity.gpx_file) %>"
    data-map-bounds-value="<%= activity.analysis.route_bounds.to_json %>"
    data-map-sections-value="<%= sections.map(&:to_time_window).to_json %>"
    data-action="turbo:morph-element->map#handleMorph"
  >
    <div class="relative isolate">
      <%# Shows through the transparent map container until the tiles cover it %>
      <%= route_preview_svg(activity.analysis.route_preview, class: "absolute inset-0 size-full p-8 text-fg-faint") %>

      <div
        data-map-target="loading"
        class="absolute inset-0 z-1000 flex items-center justify-center rounded-lg bg-raised/40"
      >
        <div class="size-8 animate-spin rounded-full border-2 border-line-strong border-t-accent"></div>
        <span class="ml-2 text-sm text-fg-muted">Loading route&hellip;</span>
      </div>

      <div
        data-map-target="map"
        class="route-map relative h-80 w-full rounded-lg sm:h-96 lg:h-[28rem]"
      ></div>
    </div>

    <div class="mt-3 flex items-center gap-3">
      <span class="stat-unit" data-map-target="legendMin">&ndash;</span>
      <div class="h-2 flex-1 rounded-full bg-linear-to-r from-speed-slow via-speed-medium to-speed-max"></div>
      <span class="stat-unit" data-map-target="legendMax">&ndash;</span>
    </div>
    <p class="mt-1 text-center text-[11px] uppercase tracking-wider text-fg-muted">Speed (km/h)</p>
  </div>
</div>
