<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>

  <% content_for :title, "Activities" %>

  <div class="sticky top-0 flex justify-between items-center pt-4 pb-6 bg-slate-50">
    <h1 class="font-bold text-4xl text-slate-800">Activities</h1>
    <%= link_to "Upload activity", new_activity_path,
        class: "rounded-lg py-3 px-5 bg-gradient-to-b from-blue-700 to-sky-600 text-sky-50 block font-medium" %>
  </div>

  <div>
    <h2 class="font-bold text-lg">On foil % by distance</h2>
    <%= on_foil_percentage_chart(@activities) %>
  </div>

  <div id="activities" class="min-w-full mt-4">
    <% @activities.each do |activity| %>
      <%= link_to activity do %>
        <%= render activity %>
      <% end %>
    <% end %>
  </div>
</div>
