<div class="mx-auto md:w-2/3 w-full">
  <% content_for :title, "Activities" %>

  <div class="sticky top-0 flex justify-between items-center pt-4 pb-6 bg-white">
    <h1 class="font-bold text-4xl text-slate-800">Activities</h1>
    <%= link_to "Upload activity", new_activity_path,
        class: "rounded-lg py-3 px-5 bg-blue-600 text-white inline-block font-medium cursor-pointer" %>
  </div>

  <div class="text-sm font-medium text-center text-gray-500 border-b border-gray-200 dark:text-gray-400 dark:border-gray-700">
    <ul class="flex flex-wrap mx-1">
      <li class="">
        <%= link_to activities_path, class: 'inline-flex items-center inline-block p-2 border-b-2 border-transparent rounded-t-lg bg-gray-100 hover:text-gray-600 hover:border-gray-300 dark:hover:text-gray-300' do %>
          All
          <span class="justify-center rounded-full ml-1 w-4 h-4 text-xs font-semibold text-blue-800 bg-blue-100">
            <%= @activity_kind_counts.values.sum %>
          </span>
        <% end %>
      </li>
      <% @activity_kind_counts.each do |kind, count| %>
        <li class="">
          <%= link_to activities_path(kind:), class: 'inline-flex items-center inline-block p-2 border-b-2 border-transparent rounded-t-lg hover:text-gray-600 hover:border-gray-300 dark:hover:text-gray-300' do %>
            <%= Activity.human_attribute_name("kind.#{kind}") %>
            <span class="justify-center rounded-full ml-1 w-4 h-4 text-xs font-semibold text-blue-800 bg-blue-100">
              <%= count %>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>

  <div>
    <h2 class="font-bold text-lg">On foil % by distance</h2>
-    <%= on_foil_percentage_chart(@activities) %>
  </div>

  <div id="activities" class="min-w-full mt-4">
    <% @activities.each do |activity| %>
      <%= link_to activity do %>
        <%= render activity %>
      <% end %>
    <% end %>
  </div>
</div>
