<div class="">
  <% content_for :title, "Activities" %>

  <div class="flex justify-between items-center pt-4 pb-6">
    <h1 class="font-bold text-4xl text-slate-200">Activities</h1>
    <%= link_to "Upload activity", new_activity_path,
        class: "rounded-lg py-3 px-5 bg-blue-600 text-white inline-block font-medium cursor-pointer" %>
  </div>

  <div class="grid grid-cols-2 gap-2 md:grid-cols-4 px-2 py-4 lg:px-0">
    <% t_dst = number_to_distance(@activities.sum { |a| a.analysis.distance_total }) %>
    <%= render 'info_box', label: 'Total Distance', value: t_dst %>
    <% t_foil = number_to_distance(@activities.sum { |a| a.analysis.distance_on_foil }) %>
    <%= render 'info_box', label: 'Distance on Foil', value: t_foil %>
    <% t_dur = number_to_duration(@activities.sum { |a| a.analysis.duration }) %>
    <%= render 'info_box', label: 'Total Duration', value: t_dur, color: 'fuchsia' %>
    <% t_dur_foil = number_to_duration(@activities.sum { |a| a.analysis.time_on_foil }) %>
    <%= render 'info_box', label: 'Duration on Foil', value: t_dur_foil, color: 'fuchsia' %>
  </div>

  <div>
    <h2 class="font-bold text-lg text-slate-200">On foil % by distance</h2>
    <canvas
      data-controller="chart"
      data-chart-data-value="<%= @chart_data.to_json %>"
      data-chart-options-value="<%= { interaction: { intersect: false, mode: 'index', }, scales: { y: { beginAtZero: true, min: 0, max: 100 }, y2: { beginAtZero: true, position: 'right' } } }.to_json %>"
    ></canvas>
  </div>

  <div id="activities" class="min-w-full mt-4">
    <% @activities.each do |activity| %>
      <%= link_to activity do %>
        <%= render activity %>
      <% end %>
    <% end %>
  </div>
</div>
