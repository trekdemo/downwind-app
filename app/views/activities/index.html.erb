<% content_for :title, "Training log" %>

<%# TODO: What would it look like with turbo_frame? %>
<%= turbo_stream_from current_user, :activities %>

<div class="flex flex-col gap-4 pb-6 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight text-fg-strong sm:text-3xl">Training log</h1>
    <p class="mt-1 text-sm text-fg-muted"><%= pluralize(@activities.size, "session") %></p>
  </div>

  <%= render "kind_filter", kind: @kind %>
</div>

<% if @activities.empty? %>
  <%= render "activities/empty_state" %>
<% else %>
  <%= render "activities/stats", activities: @activities %>

  <h2 class="mb-3 text-lg font-semibold text-fg-emphasis">Recent activities</h2>
  <div id="activities" class="flex flex-col gap-3">
    <% @activities.each do |activity| %>
      <%= link_to activity, class: "block" do %>
        <%= render activity %>
      <% end %>
    <% end %>
  </div>
<% end %>
