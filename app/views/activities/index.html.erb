<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>

  <% content_for :title, "Activities" %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Activities</h1>
    <%= link_to "Upload activity", new_activity_path, class: "rounded-lg py-3 px-5 bg-blue-600 text-white block font-medium" %>
  </div>

  <div id="activities" class="min-w-full mt-4">
    <% @activities.each do |activity| %>
      <div id="<%= dom_id activity %>" class="my-2 p-4 border border-gray-200 rounded-lg bg-gray-50">
        <%= link_to activity, class: 'flex justify-between items-top' do %>
          <h2 class="text-lg font-bold"><%= activity.title %></h2>
          <time class="text-xs basis-1/3 text-right" datetime="<%= activity.started_at.iso8601 %>"><%= l(activity.started_at, format: :short) %></time>
        <% end %>

        <div id="<%= dom_id activity, :stats %>" class="grid grid-cols-4 gap-2 text-center text-s mt-2">
          <div class="rounded border px-1 py-2"><div class="text-xs">Paddle ups</div><%= activity.analysis.paddle_ups %></div>
          <div class="rounded border px-1 py-2"><div class="text-xs">Distance (total)</div><%= number_to_distance(activity.analysis.total_distance) %></div>
          <div class="rounded border px-1 py-2"><div class="text-xs">Distance (on foil)</div><%= number_to_distance(activity.analysis.distance_on_foil) %></div>
          <div class="rounded border px-1 py-2"><div class="text-xs">Distance (on foil)</div><%= number_to_percentage(activity.analysis.distance_on_foil_percentage, precision: 0) %></div>
        </div>
      </div>
    <% end %>
  </div>
</div>
