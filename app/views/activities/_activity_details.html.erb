<%# locals: (activity:) %>
<div class="space-y-4">
  <%= render "detail_hero", activity: activity %>

  <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
    <%= render "detail_map", activity: activity %>
    <%= render "detail_foiling_chart", activity: activity %>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <%= render "detail_speed", activity: activity %>
    <%= render "detail_pace", activity: activity %>
    <%= render "detail_heart_rate", activity: activity %>
    <%= render "detail_foiling_stats", activity: activity %>
  </div>
</div>
