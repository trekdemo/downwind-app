<%# locals: (activity:) %>

<% sections = activity.analysis.on_foil_sections %>

<div class="space-y-4">
  <%= render "detail_hero", activity: activity %>

  <div
    class="space-y-4"
    data-controller="on-foil-sections"
    data-on-foil-sections-map-outlet="#<%= dom_id activity, :map %>"
    data-action="map:section-enter->on-foil-sections#enter map:section-leave->on-foil-sections#leave"
  >
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
      <%= render "detail_map", activity: activity, sections: sections %>
      <%= render "detail_foiling_chart", activity: activity %>
    </div>

    <%= render "detail_on_foil_sections", sections: sections %>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-[repeat(auto-fit,minmax(18rem,1fr))]">
    <%= render "detail_speed", activity: activity %>
    <%= render "detail_heart_rate", activity: activity %>
    <%= render "detail_pace", activity: activity if activity.paced? %>
  </div>
</div>
