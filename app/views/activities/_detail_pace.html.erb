<%# locals: (activity:) %>
<% analysis = activity.analysis %>
<div id="<%= dom_id activity, :pace %>" class="card">
  <div class="card-header">
    <h2 class="card-title flex items-center gap-1.5">
      <%= icon :clock, class: "size-4 text-accent" %>
      Pace
    </h2>
  </div>

  <div class="card-body grid grid-cols-2 gap-4">
    <%= render "application/stat", label: "Fastest 1 km", value: analysis.fastest_full_km ? duration_parts(analysis.fastest_full_km)[0] : "–", size: :sm %>
    <%= render "application/stat", label: "Fastest 10 km", value: analysis.fastest_full_10km ? duration_parts(analysis.fastest_full_10km)[0] : "–", size: :sm %>
  </div>
</div>
