<div id="<%= dom_id activity, :summary %>" class="grid grid-cols-4 text-center items-stretch text-s divide-x divide-slate-300 divide-dotted">
  <% {
    'Duration' => number_to_duration(activity.duration),
    'Distance' => number_to_distance(activity.total_distance),
    'Heartrate (avg)' => number_with_precision(activity.hr_avg, precision: 0),
    'Paddle ups' => activity.paddle_ups,
  }.each_pair do |label, value| %>
    <div class="px-1 my-2 text-slate-700 font-semibold flex flex-col justify-between">
      <div class="text-xs font-light"><%= label %></div>
      <%= value %>
    </div>
  <% end %>
</div>
