<%# locals: (activity:) %>
<% analysis = activity.analysis %>
<div class="card">
  <div class="card-header">
    <h2 class="card-title flex items-center gap-1.5">
      <%= icon :wave, class: "size-4 text-cyan-400" %>
      Foiling
    </h2>
  </div>

  <div class="card-body grid grid-cols-2 gap-4">
    <%= render "application/stat", label: "Distance on foil", value: distance_parts(analysis.distance_on_foil)[0], unit: distance_parts(analysis.distance_on_foil)[1], icon: :ruler, size: :sm %>
    <%= render "application/stat", label: "Time on foil", value: duration_parts(analysis.time_on_foil)[0], icon: :clock, size: :sm %>
    <%= render "application/stat", label: "Paddle-ups", value: analysis.starts, icon: :flag, size: :sm %>
  </div>
</div>
