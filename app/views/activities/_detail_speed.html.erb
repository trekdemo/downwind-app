<%# locals: (activity:) %>
<% analysis = activity.analysis %>
<div id="<%= dom_id activity, :speed %>" class="card">
  <div class="card-header">
    <h2 class="card-title flex items-center gap-1.5">
      <%= icon :bolt, class: "size-4 text-cyan-400" %>
      Speed
    </h2>
  </div>

  <div class="card-body grid grid-cols-2 gap-4">
    <% [
      [ "Avg speed", speed_parts(analysis.speed_avg * 3.6) ],
      [ "Max speed", speed_parts(analysis.speed_max * 3.6) ],
      [ "Avg on foil", speed_parts(analysis.speed_avg_on_foil * 3.6) ],
      [ "Lift speed", speed_parts(activity.lift_speed_kmh) ],
    ].each do |label, (value, unit)| %>
      <%= render "application/stat", label: label, value: value, unit: unit, size: :sm %>
    <% end %>
  </div>
</div>
