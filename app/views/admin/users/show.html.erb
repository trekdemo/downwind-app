<div class="w-full p-4">
  <div class="p-4">
    <h1 class="font-bold text-4xl mb-6"><%= @user.email %></h1>

    <div class="mb-4">
      <%= link_to "Back to users", admin_users_path, class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
      <%= link_to "Edit", edit_admin_user_path(@user), class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
      <div class="inline-block">
        <%= button_to "Destroy this user", [:admin, @user], method: :delete, data: { turbo_confirm: 'Are you sure?' }, class: "mt-2 rounded-lg py-3 px-5 bg-red-100 font-medium" %>
      </div>
    </div>

    <h2 class="font-bold text-4xl mb-6">Activities</h2>
    <div class="relative overflow-x-auto shadow-md sm:rounded-lg">
      <table class="w-full text-sm text-left rtl:text-right text-gray-500 dark:text-gray-400">
          <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
              <tr>
                  <th scope="col" class="px-6 py-3"> Title </th>
                  <th scope="col" class="px-6 py-3"> Lift speed </th>
              </tr>
          </thead>
          <tbody>
              <% @user.activities.each do |activity| %>
                <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600">
                    <th scope="row" class="px-4 py-2 font-medium text-gray-900 whitespace-nowrap dark:text-white">
                      <%= activity.title %>
                    </th>
                    <td class="px-6 py-4">
                      <%= activity.lift_speed %>
                    </td>
                </tr>
              <% end %>
          </tbody>
      </table>
  </div>
  </div>

</div>
