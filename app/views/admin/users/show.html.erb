<% content_for :title, @user.email %>

<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-semibold tracking-tight text-fg-strong sm:text-3xl"><%= @user.email %></h1>
  <div class="flex gap-2">
    <%= link_to "Back to users", admin_users_path, class: "btn-ghost btn-sm" %>
    <%= link_to "Edit", edit_admin_user_path(@user), class: "btn-secondary btn-sm" %>
    <%= button_to "Destroy this user", [:admin, @user], method: :delete,
        data: { turbo_confirm: "Are you sure?" }, class: "btn-danger btn-sm" %>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <span class="card-title">Activities</span>
  </div>

  <div class="overflow-x-auto">
    <table class="table">
      <thead>
        <tr>
          <th scope="col">Title</th>
          <th scope="col">Lift speed</th>
        </tr>
      </thead>
      <tbody>
        <% @user.activities.each do |activity| %>
          <tr>
            <td class="font-medium text-fg-emphasis"><%= activity.title %></td>
            <td><%= activity.lift_speed_kmh %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
