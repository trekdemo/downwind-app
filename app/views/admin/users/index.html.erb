<% content_for :title, "Users" %>

<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-semibold tracking-tight text-fg-strong sm:text-3xl">Users</h1>
</div>

<div class="card overflow-x-auto">
  <table class="table">
    <thead>
      <tr>
        <th scope="col">Email</th>
        <th scope="col">Activities</th>
        <th scope="col"><span class="sr-only">Action</span></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td class="font-medium text-fg-emphasis"><%= user.email %></td>
          <td><%= user.activities.size %></td>
          <td class="text-right">
            <%= link_to "Details", [:admin, user], class: "link" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
