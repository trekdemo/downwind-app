<%= form_with(model: [:admin, user], class: "space-y-4") do |form| %>
  <% if user.errors.any? %>
    <div id="error_explanation" class="card ring-1 ring-inset ring-danger-hover/30 bg-danger-hover/5 px-4 py-3">
      <h2 class="font-medium text-danger-fg">
        <%= pluralize(user.errors.count, "error") %> prohibited this admin_user from being saved:
      </h2>

      <ul class="mt-2 list-inside list-disc text-sm text-danger-fg-soft/90">
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :email, class: "label" %>
    <%= form.email_field :email, class: "input" %>
  </div>

  <div>
    <%= form.submit class: "btn-primary" %>
  </div>
<% end %>
