<% content_for :title, "Design components" %>

<% sections = {
  colors: "Colors",
  typography: "Typography",
  buttons: "Buttons",
  badges: "Badges",
  navigation: "Navigation",
  cards: "Cards",
  stats: "Stats",
  forms: "Forms",
  feedback: "Feedback",
  tables: "Tables",
  data: "Data visualisation",
  icons: "Icons"
} %>

<div class="flex flex-col gap-4 pb-6">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight text-fg-strong sm:text-3xl">Design components</h1>
    <p class="mt-1 text-sm text-fg-muted">
      Every shared component, rendered with the same classes, partials and helpers as the app.
      Defined in <code class="text-fg-secondary">app/assets/tailwind/application.css</code> unless noted.
    </p>
  </div>

  <nav aria-label="Sections" class="flex flex-wrap gap-2">
    <% sections.each do |id, label| %>
      <%= link_to label, "##{id}", class: "inline-flex items-center rounded-full bg-raised px-3 py-1.5 text-sm font-medium text-fg-muted ring-1 ring-inset ring-line-subtle transition-colors hover:bg-sunken hover:text-fg" %>
    <% end %>
  </nav>
</div>

<div class="space-y-6">
  <%# ---------------------------------------------------------------- Colors %>
  <section id="colors" class="card scroll-mt-20">
    <div class="card-header">
      <h2 class="card-title"><%= sections[:colors] %></h2>
      <span class="stat-unit">Semantic roles, light | dark</span>
    </div>
    <div class="card-body space-y-8">
      <% Admin::DesignComponentsHelper::COLOR_ROLES.each do |group| %>
        <div>
          <h3 class="mb-3 text-sm font-semibold text-fg-emphasis"><%= group[:group] %></h3>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            <% group[:colors].each do |color| %>
              <div class="flex gap-3 rounded-lg bg-canvas/60 p-3 ring-1 ring-inset ring-line-subtle">
                <div class="flex size-12 shrink-0 overflow-hidden rounded-lg ring-1 ring-inset ring-line-strong/40">
                  <div class="flex-1 scheme-light <%= color[:swatch] %>"></div>
                  <div class="flex-1 scheme-dark <%= color[:swatch] %>"></div>
                </div>
                <div class="min-w-0 space-y-1">
                  <p class="flex flex-wrap items-baseline gap-x-2">
                    <span class="text-sm font-medium text-fg-emphasis"><%= swatch_role(color) %></span>
                    <code class="text-xs text-fg-muted"><%= swatch_label(color) %></code>
                  </p>
                  <p class="text-xs text-fg-muted"><%= color[:usage] %></p>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <p class="text-xs text-fg-muted">
        Defined as <code class="text-fg-secondary">light-dark()</code> pairs in the semantic
        <code class="text-fg-secondary">@theme</code> block; the page follows the OS colour scheme.
      </p>
    </div>
  </section>

  <%# ------------------------------------------------------------ Typography %>
  <section id="typography" class="card scroll-mt-20">
    <div class="card-header"><h2 class="card-title"><%= sections[:typography] %></h2></div>
    <div class="card-body grid grid-cols-1 gap-6 lg:grid-cols-2">
      <%= design_example "Page title", source: "views (h1)" do %>
        <h1 class="text-2xl font-semibold tracking-tight text-fg-strong sm:text-3xl">Training log</h1>
        <p class="mt-1 text-sm text-fg-muted">12 sessions</p>
      <% end %>

      <%= design_example "Auth card title", source: "sessions/new, passwords/*" do %>
        <h1 class="text-xl font-semibold tracking-tight text-fg-strong">Sign in</h1>
      <% end %>

      <%= design_example "Section heading", source: "activities/index" do %>
        <h2 class="text-lg font-semibold text-fg-emphasis">Recent activities</h2>
      <% end %>

      <%= design_example "Eyebrow label", source: ".card-title, .stat-label, th" do %>
        <p class="card-title">Heart rate</p>
      <% end %>

      <%= design_example "Body and muted text", source: "<body>, views" do %>
        <p class="text-sm text-fg">Body text inherits fg from &lt;body&gt;.</p>
        <p class="mt-1 text-sm text-fg-muted">Muted helper text in fg-muted.</p>
      <% end %>

      <%= design_example "Link", source: ".link" do %>
        <p class="text-sm">Drop your GPX file here or <%= link_to "browse", "#", class: "link" %></p>
      <% end %>
    </div>
  </section>

  <%# --------------------------------------------------------------- Buttons %>
  <section id="buttons" class="card scroll-mt-20">
    <div class="card-header"><h2 class="card-title"><%= sections[:buttons] %></h2></div>
    <div class="card-body grid grid-cols-1 gap-6 lg:grid-cols-2">
      <%= design_example "Variants", source: ".btn-primary, .btn-secondary, .btn-ghost, .btn-danger" do %>
        <div class="flex flex-wrap gap-2">
          <button type="button" class="btn-primary">Primary</button>
          <button type="button" class="btn-secondary">Secondary</button>
          <button type="button" class="btn-ghost">Ghost</button>
          <button type="button" class="btn-danger">Danger</button>
        </div>
      <% end %>

      <%= design_example "Small, with icon", source: ".btn-sm" do %>
        <div class="flex flex-wrap gap-2">
          <button type="button" class="btn-primary btn-sm"><%= icon :upload, class: "size-4" %> Upload</button>
          <button type="button" class="btn-secondary btn-sm"><%= icon :pencil, class: "size-4" %> Edit</button>
          <button type="button" class="btn-ghost btn-sm">Back to users</button>
          <button type="button" class="btn-danger btn-sm"><%= icon :trash, class: "size-4" %> Delete</button>
        </div>
      <% end %>

      <%= design_example "Disabled", source: ".btn disabled:" do %>
        <div class="flex flex-wrap gap-2">
          <button type="button" class="btn-primary" disabled>Primary</button>
          <button type="button" class="btn-secondary" disabled>Secondary</button>
        </div>
      <% end %>

      <%= design_example "Full width", source: "sessions/_form" do %>
        <button type="button" class="btn-primary w-full">Sign in</button>
      <% end %>
    </div>
  </section>

  <%# ---------------------------------------------------------------- Badges %>
  <section id="badges" class="card scroll-mt-20">
    <div class="card-header"><h2 class="card-title"><%= sections[:badges] %></h2></div>
    <div class="card-body grid grid-cols-1 gap-6 lg:grid-cols-2">
      <%= design_example "Activity kind", source: "ActivitiesHelper#kind_badge" do %>
        <div class="flex flex-wrap gap-2">
          <% Activity.kinds.each_key do |kind| %>
            <%= kind_badge(kind) %>
          <% end %>
        </div>
      <% end %>

      <%= design_example "Status and neutral", source: ".badge-pending, .badge-neutral" do %>
        <div class="flex flex-wrap gap-2">
          <span class="badge-pending">Analyzing…</span>
          <span class="badge-neutral"><%= icon :bolt, class: "size-3.5 text-accent" %> Lift speed 12.0 km/h</span>
        </div>
      <% end %>
    </div>
  </section>

  <%# ------------------------------------------------------------ Navigation %>
  <section id="navigation" class="card scroll-mt-20">
    <div class="card-header"><h2 class="card-title"><%= sections[:navigation] %></h2></div>
    <div class="card-body grid grid-cols-1 gap-6 lg:grid-cols-2">
      <%= design_example "Logo tile", source: "application/_header" do %>
        <div class="flex items-center gap-2 font-semibold text-fg-emphasis">
          <span class="flex size-8 items-center justify-center rounded-lg bg-accent-solid/10 text-accent">
            <%= icon :wave, class: "size-5" %>
          </span>
          Downwind Logbook
        </div>
      <% end %>

      <%= design_example "Header nav link", source: "application/_header" do %>
        <div class="flex items-center gap-1">
          <a href="#" aria-current="page" class="rounded-full px-3 py-1.5 text-sm font-medium bg-accent-solid/10 text-accent-fg">Dashboard</a>
          <a href="#" class="rounded-full px-3 py-1.5 text-sm font-medium text-fg-muted hover:text-fg-emphasis">Inactive</a>
        </div>
      <% end %>

      <%= design_example "Filter pills", source: "activities/index" do %>
        <div class="flex flex-wrap gap-2">
          <a href="#" aria-current="page" class="inline-flex items-center rounded-full px-3 py-1.5 text-sm font-medium ring-1 ring-inset transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-canvas bg-accent-solid/10 text-accent-fg ring-accent-solid/30">All</a>
          <a href="#" class="inline-flex items-center rounded-full px-3 py-1.5 text-sm font-medium ring-1 ring-inset transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-canvas bg-raised text-fg-muted ring-line-subtle hover:bg-sunken hover:text-fg">Wingfoil</a>
        </div>
      <% end %>

      <%= design_example "Back link and avatar", source: "activities/show, application/_header" do %>
        <div class="flex items-center justify-between">
          <a href="#" class="inline-flex items-center gap-1.5 text-sm text-fg-muted hover:text-accent-fg">
            <%= icon :"arrow-left", class: "size-4" %> Training log
          </a>
          <span class="flex size-8 items-center justify-center rounded-full bg-sunken text-xs font-semibold uppercase text-fg-secondary">g</span>
        </div>
      <% end %>
    </div>
  </section>

  <%# ----------------------------------------------------------------- Cards %>
  <section id="cards" class="card scroll-mt-20">
    <div class="card-header"><h2 class="card-title"><%= sections[:cards] %></h2></div>
    <div class="card-body grid grid-cols-1 gap-6 lg:grid-cols-2">
      <%= design_example "Card with header", source: ".card, .card-header, .card-title, .card-body" do %>
        <div class="card">
          <div class="card-header">
            <h2 class="card-title flex items-center gap-1.5"><%= icon :bolt, class: "size-4 text-accent" %> Speed</h2>
            <span class="stat-unit">3 sections</span>
          </div>
          <div class="card-body text-sm">Card content</div>
        </div>
      <% end %>

      <%= design_example "Plain card", source: ".card .card-body" do %>
        <div class="card card-body text-sm">A card without a header, e.g. the auth and form pages.</div>
      <% end %>

      <%= design_example "Interactive card", source: "activities/_activity" do %>
        <div class="card card-body transition hover:ring-1 hover:ring-accent-solid/40">
          <div class="mb-1.5"><%= kind_badge("sup_dw") %></div>
          <h3 class="truncate text-base font-semibold text-fg-emphasis hover:text-accent">Morning downwinder</h3>
        </div>
      <% end %>

      <%= design_example "Empty state", source: "activities/index" do %>
        <div class="card card-body flex flex-col items-center gap-3 py-10 text-center">
          <%= icon :wave, class: "size-10 text-fg-faint" %>
          <h2 class="text-lg font-semibold text-fg">No activities yet</h2>
          <p class="max-w-sm text-sm text-fg-muted">Upload a GPX file to see your stats here.</p>
          <a href="#" class="btn-primary mt-2"><%= icon :upload, class: "size-4" %> Upload your first GPX</a>
        </div>
      <% end %>
    </div>
  </section>

  <%# ----------------------------------------------------------------- Stats %>
  <section id="stats" class="card scroll-mt-20">
    <div class="card-header"><h2 class="card-title"><%= sections[:stats] %></h2></div>
    <div class="card-body grid grid-cols-1 gap-6 lg:grid-cols-2">
      <%= design_example "Stat sizes", source: "application/_stat" do %>
        <div class="grid grid-cols-3 gap-4">
          <%= render "application/stat", label: "Small", value: "12.4", unit: "km", size: :sm %>
          <%= render "application/stat", label: "Medium", value: "12.4", unit: "km", icon: :ruler %>
          <%= render "application/stat", label: "Large", value: "12.4", unit: "km", icon: :ruler, size: :lg %>
        </div>
      <% end %>

      <%= design_example "Inline stat", source: ".stat-label, .stat-value, .stat-unit" do %>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <p class="stat-label">Distance</p>
            <p><span class="stat-value text-lg">12.4</span> <span class="stat-unit">km</span></p>
          </div>
          <div>
            <p class="stat-label">Duration</p>
            <p><span class="stat-value text-lg">1:23:45</span></p>
          </div>
        </div>
      <% end %>

      <%= design_example "Summary stat card", source: "activities/index" do %>
        <div class="card card-body">
          <%= render "application/stat", label: "Time on foil", value: "4:12:08", icon: :clock %>
        </div>
      <% end %>
    </div>
  </section>

  <%# ----------------------------------------------------------------- Forms %>
  <section id="forms" class="card scroll-mt-20">
    <div class="card-header"><h2 class="card-title"><%= sections[:forms] %></h2></div>
    <%= form_with url: "#", scope: :demo, method: :get, class: "card-body grid grid-cols-1 gap-6 lg:grid-cols-2" do |form| %>
      <%= design_example "Text input", source: ".label, .input" do %>
        <%= form.label :email, class: "label" %>
        <%= form.email_field :email, class: "input", placeholder: "you@example.com" %>
      <% end %>

      <%= design_example "Input with suffix", source: "activities/_form" do %>
        <%= form.label :lift_speed_kmh, "Lift speed", class: "label" %>
        <div class="relative">
          <%= form.number_field :lift_speed_kmh, step: 0.1, min: 0, value: 12, class: "input pr-14" %>
          <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-sm text-fg-muted">km/h</span>
        </div>
      <% end %>

      <%= design_example "Select", source: ".select" do %>
        <%= form.label :kind, "Kind", class: "label" %>
        <%= form.select :kind, options_for_enum(Activity, :kind), {}, class: "select" %>
      <% end %>

      <%= design_example "Radio cards", source: "activities/_form" do %>
        <span class="label">Kind</span>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <% Activity.kinds.keys.each_with_index do |kind, index| %>
            <div>
              <%= form.radio_button :radio_kind, kind, checked: index.zero?, class: "peer sr-only" %>
              <%= form.label "radio_kind_#{kind}",
                  Activity.human_attribute_name("kind.#{kind}"),
                  class: "flex cursor-pointer items-center justify-center rounded-lg px-4 py-3 text-sm font-medium text-fg-secondary ring-1 ring-inset ring-line transition-colors hover:bg-sunken peer-checked:bg-accent-solid/10 peer-checked:text-accent-fg peer-checked:ring-accent peer-focus-visible:ring-2 peer-focus-visible:ring-accent" %>
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="lg:col-span-2">
        <%= design_example "File dropzone", source: "activities/_form + file-input controller" do %>
          <div data-controller="file-input" data-file-input-dragover-class="border-accent bg-accent-solid/5">
            <%= form.label :gpx_file,
                class: "flex w-full flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-line bg-raised/50 px-4 py-10 text-center transition-colors hover:border-accent hover:bg-accent-solid/5",
                data: { file_input_target: "dropzone", action: "dragover->file-input#dragover dragleave->file-input#dragleave drop->file-input#drop" } do %>
              <span class="flex size-12 items-center justify-center rounded-full bg-sunken text-accent">
                <%= icon :upload, class: "size-6" %>
              </span>
              <span class="text-sm font-semibold text-fg">
                Drop your GPX file here or <span class="link">browse</span>
              </span>
              <span class="text-xs text-fg-muted">GPX export from your watch or phone</span>
              <span class="text-xs font-medium text-accent-fg" data-file-input-target="filename"></span>
              <%= form.file_field :gpx_file, class: "sr-only", data: { file_input_target: "input", action: "change->file-input#change" } %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>

  <%# -------------------------------------------------------------- Feedback %>
  <section id="feedback" class="card scroll-mt-20">
    <div class="card-header"><h2 class="card-title"><%= sections[:feedback] %></h2></div>
    <div class="card-body grid grid-cols-1 gap-6 lg:grid-cols-2">
      <%= design_example "Flash notice", source: "application/_flash" do %>
        <div class="flex items-center gap-2 rounded-xl bg-success/10 px-4 py-3 text-sm font-medium text-success-fg ring-1 ring-inset ring-success/30">
          <%= icon :check, class: "size-5 shrink-0" %>
          <span>Activity was successfully updated.</span>
        </div>
      <% end %>

      <%= design_example "Flash alert", source: "application/_flash" do %>
        <div class="flex items-center gap-2 rounded-xl bg-danger-hover/10 px-4 py-3 text-sm font-medium text-danger-fg ring-1 ring-inset ring-danger-hover/30">
          <%= icon :x, class: "size-5 shrink-0" %>
          <span>Bad email or password.</span>
        </div>
      <% end %>

      <%= design_example "Form errors", source: "activities/_form, admin/users/_form" do %>
        <div class="card ring-1 ring-inset ring-danger-hover/30 bg-danger-hover/5 px-4 py-3">
          <div class="flex items-center gap-2 text-danger-fg">
            <%= icon :x, class: "size-5 shrink-0" %>
            <h2 class="font-medium">1 error prohibited this activity from being saved:</h2>
          </div>
          <ul class="mt-2 list-inside list-disc text-sm text-danger-fg-soft/90">
            <li>Gpx file can't be blank</li>
          </ul>
        </div>
      <% end %>

      <%= design_example "Success icon", source: "passwords/create" do %>
        <span class="flex size-10 items-center justify-center rounded-full bg-success/10 text-success-icon">
          <%= icon :check, class: "size-5" %>
        </span>
      <% end %>

      <%= design_example "Spinners", source: "activities/_detail_analyzing, _detail_map" do %>
        <div class="flex items-center gap-6">
          <div class="size-10 animate-spin rounded-full border-2 border-line border-t-accent"></div>
          <div class="flex items-center">
            <div class="size-8 animate-spin rounded-full border-2 border-line-strong border-t-accent"></div>
            <span class="ml-2 text-sm text-fg-muted">Loading route&hellip;</span>
          </div>
        </div>
      <% end %>

      <%= design_example "Skeleton", source: "activities/_activity" do %>
        <div class="animate-pulse space-y-3" role="status">
          <div class="h-4 w-1/3 rounded-full bg-sunken"></div>
          <div class="grid grid-cols-4 gap-3">
            <div class="h-10 rounded-lg bg-sunken"></div>
            <div class="h-10 rounded-lg bg-sunken"></div>
            <div class="h-10 rounded-lg bg-sunken"></div>
            <div class="h-10 rounded-lg bg-sunken"></div>
          </div>
          <span class="sr-only">Loading…</span>
        </div>
      <% end %>
    </div>
  </section>

  <%# ---------------------------------------------------------------- Tables %>
  <section id="tables" class="card scroll-mt-20">
    <div class="card-header"><h2 class="card-title"><%= sections[:tables] %></h2></div>
    <div class="card-body">
      <%= design_example "Table in a card", source: ".table" do %>
        <div class="card overflow-x-auto">
          <table class="table">
            <thead>
              <tr>
                <th scope="col">#</th>
                <th scope="col">Duration</th>
                <th scope="col">Avg HR</th>
                <th scope="col"><span class="sr-only">Action</span></th>
              </tr>
            </thead>
            <tbody>
              <% [ [ "0:01:12", 142 ], [ "0:00:48", 151 ] ].each_with_index do |(duration, hr), index| %>
                <tr class="tabular-nums">
                  <td class="text-fg-muted"><%= index + 1 %></td>
                  <td class="font-medium text-fg-emphasis"><%= duration %></td>
                  <td><%= hr %> <span class="stat-unit">bpm</span></td>
                  <td class="text-right"><a href="#" class="link">Details</a></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </section>

  <%# ---------------------------------------------------- Data visualisation %>
  <section id="data" class="card scroll-mt-20">
    <div class="card-header"><h2 class="card-title"><%= sections[:data] %></h2></div>
    <div class="card-body grid grid-cols-1 gap-6 lg:grid-cols-2">
      <%= design_example "On-foil progress", source: ".progress-foil" do %>
        <div class="mb-1 flex items-center justify-between text-xs">
          <span class="text-fg-muted">On foil</span>
          <span class="tabular-nums text-accent">64%</span>
        </div>
        <progress class="progress-foil" max="100" value="64"></progress>
      <% end %>

      <%= design_example "Speed legend", source: "activities/_detail_map + map controller" do %>
        <div class="flex items-center gap-3">
          <span class="stat-unit">8</span>
          <div class="h-2 flex-1 rounded-full bg-linear-to-r from-speed-slow via-speed-medium to-speed-max"></div>
          <span class="stat-unit">24</span>
        </div>
        <p class="mt-1 text-center text-[11px] uppercase tracking-wider text-fg-muted">Speed (km/h)</p>
      <% end %>

      <%= design_example "Route preview", source: "ActivitiesHelper#route_preview_svg" do %>
        <div class="flex gap-4">
          <div class="size-24 rounded-lg bg-canvas/60 p-2 text-accent/80">
            <%= route_preview_svg(sample_route_preview, class: "size-full") %>
          </div>
          <div class="size-24 p-2 text-fg-faint">
            <%= route_preview_svg(sample_route_preview, class: "size-full") %>
          </div>
        </div>
      <% end %>

      <%= design_example "Doughnut chart", source: "activities/_detail_foiling_chart + chart controller" do %>
        <div class="relative h-44">
          <canvas
            class="absolute inset-0"
            data-controller="chart"
            data-chart-type-value="doughnut"
            data-chart-data-value="<%= {
              labels: [ "On foil", "Off foil" ],
              datasets: [
                { label: "Distance", data: [ 64, 36 ], backgroundColor: [ "var(--color-accent-solid)", "var(--color-chart-off-foil)" ], borderWidth: 0 },
                { label: "Time", data: [ 58, 42 ], backgroundColor: [ "var(--color-accent-solid)", "var(--color-chart-off-foil)" ], borderWidth: 0 }
              ]
            }.to_json %>"
            data-chart-options-value="<%= { cutout: "70%", plugins: { legend: { display: false } } }.to_json %>"
          ></canvas>
          <div class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center">
            <span class="stat-value text-3xl">64%</span>
            <span class="stat-label">On foil</span>
          </div>
        </div>
      <% end %>

      <div class="lg:col-span-2">
        <%= design_example "Progress chart", source: "dashboard/index + DashboardController#index" do %>
          <div class="h-64">
            <canvas
              data-controller="chart"
              data-chart-data-value="<%= {
                labels: %w[Jun Jul Aug Sep Oct],
                datasets: [
                  { label: "% on foil", data: [ 22, 35, 41, 58, 64 ], borderColor: "var(--color-accent)", backgroundColor: "color-mix(in oklab, var(--color-accent) 15%, transparent)", borderWidth: 2, pointStyle: false, type: "line", fill: true, tension: 0.3, suffix: "%", yAxisID: "y" },
                  { label: "Paddle-ups", data: [ 9, 7, 6, 4, 3 ], backgroundColor: "var(--color-chart-series-secondary)", borderWidth: 0, borderRadius: 4, barPercentage: 0.5, type: "bar", yAxisID: "y2" }
                ]
              }.to_json %>"
              data-chart-options-value="<%= {
                scales: {
                  y: { beginAtZero: true, min: 0, max: 100, position: "left" },
                  y2: { beginAtZero: true, position: "right", grid: { display: false } }
                }
              }.to_json %>"
            ></canvas>
          </div>
        <% end %>
      </div>

      <div class="lg:col-span-2">
        <%= design_example "Heatmap", source: "dashboard/index + DashboardController#heatmap_data_for" do %>
          <% weeks = %w[Sep\ 8 Sep\ 15 Sep\ 22 Sep\ 29 Oct\ 6] %>
          <% weekdays = %w[Mon Tue Wed Thu Fri Sat Sun] %>
          <% levels = [ 0, 2, 0, 0, 1, 4, 3, 0, 0, 1, 0, 0, 2, 0, 3, 0, 0, 2, 0, 4, 1, 0, 1, 0, 0, 3, 0, 2, 0, 0, 2, 0, 0, 0, 0 ] %>
          <div class="h-48">
            <canvas
              data-controller="chart"
              data-chart-type-value="matrix"
              data-chart-data-value="<%= {
                xLabels: weeks,
                yLabels: weekdays,
                datasets: [ {
                  label: "Time on the water",
                  data: levels.each_index.map { |i| { x: weeks[i / 7], y: weekdays[i % 7], title: "#{weekdays[i % 7]}, #{weeks[i / 7]}", label: levels[i].zero? ? "No sessions" : "#{levels[i]}:00:00" } },
                  backgroundColor: levels.map { |level| level.zero? ? "var(--color-line-subtle)" : "color-mix(in oklab, var(--color-accent) #{DashboardController::HEATMAP_LEVELS[level - 1]}%, transparent)" },
                  borderWidth: 0,
                  borderRadius: 3
                } ]
              }.to_json %>"
            ></canvas>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <%# ----------------------------------------------------------------- Icons %>
  <section id="icons" class="card scroll-mt-20">
    <div class="card-header">
      <h2 class="card-title"><%= sections[:icons] %></h2>
      <code class="text-xs text-fg-placeholder">ApplicationHelper#icon</code>
    </div>
    <div class="card-body grid grid-cols-3 gap-3 sm:grid-cols-6 lg:grid-cols-8">
      <% icon_names.each do |name| %>
        <div class="flex flex-col items-center gap-2 rounded-lg bg-canvas/60 p-3 text-fg ring-1 ring-inset ring-line-subtle">
          <%= icon name, class: "size-6" %>
          <code class="truncate text-[11px] text-fg-muted"><%= name %></code>
        </div>
      <% end %>
    </div>
  </section>
</div>
