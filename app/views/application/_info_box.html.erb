<%# locals: (label:, value:, unit: false, color: "indigo") %>
<div class="border-2 p-5 inline-block rounded-2xl text-slate-100 border-blue-700 bg-blue-700">
  <p class="text-xs mb-1 font-light uppercase"><%= label %></p>
  <p class="text-xs font-light text-right">
    <strong class="text-4xl font-semibold"><%= value %></strong>
    <%- if unit %>
      <span class="uppercase"><%= unit %></span>
    <%- end %>
  </p>
</div>
