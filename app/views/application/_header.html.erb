<header class="sticky top-0 z-10 h-14 border-b border-line-subtle bg-canvas/80 backdrop-blur-sm">
  <div class="mx-auto flex h-14 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-6">
      <%= link_to root_path, class: "flex items-center gap-2 font-semibold text-fg-emphasis" do %>
        <span class="flex size-8 items-center justify-center rounded-lg bg-accent-solid/10 text-accent">
          <%= icon :wave, class: "size-5" %>
        </span>
        <span class="hidden sm:inline">Downwind Logbook</span>
      <% end %>

      <% if signed_in? %>
        <nav class="flex items-center gap-1">
          <% [ [ "Dashboard", dashboard_path, current_page?(controller: "dashboard") ],
               [ "Activities", activities_path, params[:controller] == "activities" ] ].each do |label, path, current| %>
            <%= link_to label, path,
                class: class_names("rounded-full px-3 py-1.5 text-sm font-medium",
                                   "bg-accent-solid/10 text-accent-fg": current,
                                   "text-fg-muted hover:text-fg-emphasis": !current),
                "aria-current": current ? "page" : nil %>
          <% end %>
        </nav>
      <% end %>
    </div>

    <div class="flex items-center gap-3">
      <% if signed_in? %>
        <%= link_to new_activity_path, class: "btn-primary btn-sm" do %>
          <%= icon :upload, class: "size-4" %>
          <span class="sr-only sm:not-sr-only">Upload</span>
        <% end %>

        <span class="hidden size-8 items-center justify-center rounded-full bg-sunken text-xs font-semibold uppercase text-fg-secondary sm:flex">
          <%= current_user.email.first %>
        </span>

        <%= link_to I18n.t("layouts.application.sign_out"), sign_out_path,
            class: "link text-sm", data: { turbo_method: :delete } %>
      <% else %>
        <%= link_to I18n.t("layouts.application.sign_in"), sign_in_path, class: "btn-secondary btn-sm" %>
      <% end %>
    </div>
  </div>
</header>
