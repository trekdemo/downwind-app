<div class="text-gray-50">
  <div class="p-5 grid grid-cols-2 mx-auto text-md">
    <div class="font-bold"><%= link_to '🌊 Downwind Logbook', root_path %></div>
    <div class="text-right align-baseline">
      <% if signed_in? %>
        <%= link_to I18n.t("layouts.application.sign_out"), sign_out_path, class: "", data: {turbo_method: :delete} %>
      <% else %>
        <%= link_to I18n.t("layouts.application.sign_in"), sign_in_path, class: "" %>
      <% end %>
    </div>
  </div>
</div>
