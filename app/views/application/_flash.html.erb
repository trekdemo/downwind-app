<% if notice.present? %>
  <div class="mb-4 flex items-center gap-2 rounded-xl bg-success/10 px-4 py-3 text-sm font-medium text-success-fg ring-1 ring-inset ring-success/30" id="notice">
    <%= icon :check, class: "size-5 shrink-0" %>
    <span><%= notice %></span>
  </div>
<% end %>

<% if alert.present? %>
  <div class="mb-4 flex items-center gap-2 rounded-xl bg-danger-hover/10 px-4 py-3 text-sm font-medium text-danger-fg ring-1 ring-inset ring-danger-hover/30" id="alert">
    <%= icon :x, class: "size-5 shrink-0" %>
    <span><%= alert %></span>
  </div>
<% end %>
