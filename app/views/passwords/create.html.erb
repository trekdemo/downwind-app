<% content_for :title, "Check your email" %>

<div id="clearance" class="password-reset grid min-h-[calc(100vh-10rem)] place-items-center bg-radial-[ellipse_at_top] from-accent-solid/10 to-transparent to-60%">
  <div class="w-full max-w-sm">
    <div class="mb-6 flex flex-col items-center gap-2 text-center">
      <span class="flex size-10 items-center justify-center rounded-lg bg-accent-solid/10 text-accent">
        <%= icon :wave, class: "size-6" %>
      </span>
      <span class="font-semibold text-fg-emphasis">Downwind Logbook</span>
    </div>

    <div class="card card-body text-center">
      <span class="mx-auto mb-3 flex size-10 items-center justify-center rounded-full bg-success/10 text-success-icon">
        <%= icon :check, class: "size-5" %>
      </span>
      <p class="text-sm text-fg-secondary"><%= t(".description") %></p>
    </div>
  </div>
</div>
